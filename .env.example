# URL of the per-PR preview deployment. In CI this is injected by the
# deploy-preview job in .github/workflows/e2e-on-preview.yml.
PREVIEW_URL=https://pr-123.preview.example.com

# Same URL surfaced under the name Playwright reads.
PLAYWRIGHT_BASE_URL=https://pr-123.preview.example.com

# Token your app's auth middleware accepts on preview deployments only,
# letting test traffic skip access-control gates (Vercel password
# protection, Cloudflare Access, etc.).
PREVIEW_BYPASS_TOKEN=replace-me-with-a-long-random-string

# API key the seed script uses to authenticate against the preview
# environment's /api/test/seed/* endpoints. Should only be valid in
# preview, never in production.
SEED_API_KEY=replace-me-with-a-long-random-string
